# Copy to .env and fill in OPENAI_API_KEY. Everything else has a working default.

# --- LLM (OpenAI by default; any OpenAI-compatible server via LLM_API_BASE) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-terra
# Set for Ollama / Docker Model Runner / other OpenAI-compatible servers, e.g.
# http://host.docker.internal:11434/v1 (Ollama) or http://model-runner.docker.internal/engines/v1 (DMR)
LLM_API_BASE=
# Vision model for checks (framing, scene checklist, part scores). Empty = LLM_MODEL.
VLM_MODEL=
# USD per 1M tokens for the spend meter.
LLM_PRICE_IN_PER_M=2.0
LLM_PRICE_CACHED_PER_M=0.2
LLM_PRICE_OUT_PER_M=12.0

# --- Image generation (plates: the scene without the car) ---
# openai: GPT Image edit on OPENAI_API_KEY | fal: any fal endpoint in IMAGE_MODEL (needs FAL_KEY)
# fake: offline stand-in that colours the Blender guide (for tests without credits)
IMAGE_BACKEND=openai
IMAGE_MODEL=gpt-image-2.6-flare
# openai only: low | medium | high. Use low while testing (measured ~$0.033 a plate vs ~$0.054 at high), high for finals.
IMAGE_QUALITY=high
FAL_KEY=
# Candidates per attempt; the best layout match is kept.
PLATE_CANDIDATES=2

# --- Budgets (enforced in code) ---
IMAGE_BUDGET_PER_SHOT=8
LOOPS_PER_SHOT=6
MAX_LLM_CALLS=120
SPEND_CAP_USD=45

# --- Rendering ---
RENDER_SAMPLES=128

# --- Blender on the host ---
# Empty = auto: WSL gateway address, then host.docker.internal, then localhost.
BLENDER_HOST=
BLENDER_PORT=9876
# Pause after each visible Blender step so the viewport can be followed.
TS_STEP_PAUSE_S=1.0

# --- Storage ---
POSTGRES_USER=trueshot
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=trueshot
S3_ACCESS_KEY=trueshot
S3_SECRET_KEY=change-me-s3-secret
S3_BUCKET=trueshot
# Address Blender (on the host) and the browser use for the object store. URLs are signed
# for this exact host string; 127.0.0.1 avoids Windows trying IPv6 first for localhost
# (~1 s per request).
S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333

# --- Agent ---
AGENT_PORT=8000
USER_ID=demo

# --- Docker images (compose tags the locally built images with these) ---
IMAGE_REGISTRY=trueshot
TAG=dev
# Paths inside the containers (ASSETS_DIR, OUTPUTS_DIR, MODELS_DIR, UI_DIST, BLENDER_MCP_URL) are
# set in docker-compose.yml and need no change.
